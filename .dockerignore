# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
.eggs/

# Virtual envs — builder stage creates its own
.venv/
venv/

# Dev / test artefacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Secrets — never bake into image
.env
credentials/

# Git
.git/
.gitignore

# Docker itself
Dockerfile
.dockerignore
docker-compose.yml

# Generated output — mounted as volumes at runtime
reports/
qdrant_storage/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docs that don't need to be in the image
*.md
!README.md